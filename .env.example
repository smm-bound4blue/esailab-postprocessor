# eSAILab CFD Post-Processor Environment Configuration
# Copy this file to .env and adjust values as needed

# Path to the CFD project data directory (contains one folder per test
# campaign, e.g. 2026-08-21_SMM_TEST_9M)
# Example: /home/user/esailab-postprocessor/data
CFD_PROJECT_PATH=

# Path to the SQLite results database. Defaults to db/cfd_results.db if unset.
CFD_DB_PATH=
